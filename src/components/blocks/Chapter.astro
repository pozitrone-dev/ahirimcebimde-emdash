---
import { Image } from "emdash/ui";
import { GEOS } from "../../lib/art";
const { value } = Astro.props as { value: any };
const v = value ?? {};
const COLORS: Record<string, [string, string]> = {
	pembe: ["var(--color-pink)", ""],
	turuncu: ["var(--color-orange)", "orange"],
	sari: ["var(--color-yellow)", "yellow"],
	yesil: ["var(--color-lime)", "lime"],
};
const [paper, markerClass] = COLORS[v.color] ?? COLORS.pembe;
const screens: string[] = (Array.isArray(v.screens) ? v.screens : []).slice(0, 2);
const two = screens.length === 2 && !v.image;
const chips: any[] = (v.chips ?? []).slice(0, 2);
// Two layouts from the design: two screens side by side, or one screen with cards either side.
const chipPos = two
	? ["left:380px;top:30px;width:230px", "left:20px;top:390px;width:210px"]
	: ["left:20px;top:120px;width:200px", "left:450px;top:330px;width:180px"];
const paperStyle = two
	? `background:${paper};width:330px;height:470px;left:70px;top:50px`
	: `background:${paper};width:320px;height:460px;left:200px;top:60px;transform:rotate(5deg)`;
---

<section class:list={["chapter", { flip: v.flip }]} id={v.anchor_id || undefined}>
	<div class="geo" aria-hidden="true" set:html={GEOS[v.shape] ?? GEOS.arti} />
	<div class="chapter-row">
		<div class="chapter-art">
			<div class="paper" style={paperStyle}></div>
			{
				v.image ? (
					<figure class="screen s-a" style="left:190px">
						<Image image={v.image} alt={v.image.alt || v.screens_alt || ""} width={600} height={1200} />
					</figure>
				) : two ? (
					<>
						<figure class="screen s-a" style="left:40px"><img src={`/assets/ekranlar/${screens[0]}.webp`} alt={v.screens_alt || ""} loading="lazy" /></figure>
						<figure class="screen s-b" style="left:350px"><img src={`/assets/ekranlar/${screens[1]}.webp`} alt="" loading="lazy" /></figure>
					</>
				) : screens[0] ? (
					<figure class="screen s-a" style="left:190px"><img src={`/assets/ekranlar/${screens[0]}.webp`} alt={v.screens_alt || ""} loading="lazy" /></figure>
				) : null
			}
			{
				chips.map((c, i) => (
					<div class="chip-card" style={chipPos[i]}>
						{c.label && <div class="k">{c.label}</div>}
						<div class="v">{c.value}</div>
						{c.note && <div class="s">{c.note}</div>}
					</div>
				))
			}
		</div>
		<div class="chapter-copy">
			{v.marker && <span class:list={["marker", markerClass]}>{v.marker}</span>}
			<h2 class="t-heading">{v.headline}</h2>
			{v.body && <p class="t-body">{v.body}</p>}
			{v.button_label && <a class="btn btn-compact" href={v.button_url || "#"}>{v.button_label}</a>}
		</div>
	</div>
</section>
