---
/** Renders a page's "bolumler" blocks field with the Ahırım Cebimde block components. */
import { Blocks, defineBlockComponents } from "emdash/ui";
import Hero from "./blocks/Hero.astro";
import Features from "./blocks/Features.astro";
import Announce from "./blocks/Announce.astro";
import Chapter from "./blocks/Chapter.astro";
import Invite from "./blocks/Invite.astro";
import Access from "./blocks/Access.astro";
import PageHead from "./blocks/PageHead.astro";
import FAQ from "./blocks/FAQ.astro";
import Cards from "./blocks/Cards.astro";
import Stats from "./blocks/Stats.astro";
import Text from "./blocks/Text.astro";

const { value } = Astro.props as { value: any[] };
const components = defineBlockComponents<any>({
	ac_hero: Hero,
	ac_features: Features,
	ac_announce: Announce,
	ac_chapter: Chapter,
	ac_invite: Invite,
	ac_access: Access,
	ac_page_head: PageHead,
	ac_faq: FAQ,
	ac_cards: Cards,
	ac_stats: Stats,
	ac_text: Text,
});
---

<Blocks value={value ?? []} components={components} />
