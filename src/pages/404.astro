---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---

<Base title="Sayfa bulunamadı" robots="noindex">
	<section class="page-head" style="padding-bottom:160px">
		<span class="eyebrow">404</span>
		<h1 class="t-display">Aradığınız sayfa burada değil</h1>
		<p class="t-intro">Bağlantı değişmiş ya da sayfa kaldırılmış olabilir.</p>
		<p style="margin-top:32px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
			<a class="btn btn-compact" href="/">Ana sayfa</a>
			<a class="btn btn-outline" href="/posts">Blog</a>
		</p>
	</section>
</Base>
