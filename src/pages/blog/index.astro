---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostRow from "../../components/PostRow.astro";
import { CATEGORY_STYLE, blogUrl, needsSlash } from "../../lib/site";

const fix = needsSlash(Astro.url);
if (fix) return Astro.redirect(fix, 301);

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 100,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const cats = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
);
const catOf = (p: (typeof posts)[number]) => cats.get(p.data.id)?.[0] ?? null;

// Featured band: newest "Yenilikler" post, otherwise the newest post.
const featured =
	posts.find((p) => catOf(p)?.slug === "yenilikler") ?? posts[0] ?? null;
const rest = posts.filter((p) => p !== featured);
const firstGuide = rest.findIndex(
	(p) => catOf(p) && catOf(p)?.slug !== "yenilikler",
);
const fd = featured?.data as any;
const fScreens: string[] = Array.isArray(fd?.ekran) ? fd.ekran : fd?.ekran ? [fd.ekran] : [];
---

<Base
	title="Blog: Süt ve Besi Çiftliği Rehberleri"
	description="Süt ve besi çiftliği yönetimi üzerine kaynaklı yazılar: üreme, besleme, süt kalitesi, maliyet ve kayıt tutma."
	canonical={new URL("/blog/", Astro.url.origin).href}
>
	<section class="page-head">
		<h1 class="t-display">Blog</h1>
		<p class="t-intro">
			Süt ve besi çiftliği yönetimi üzerine kaynaklı yazılar, yeni sürümler ve uygulamadaki değişiklikler. Resmi kaynaklardaki gelişmeler için <a class="link-text" href="/haberler/">Haberler</a> sayfasına bakın.
		</p>
	</section>

	{
		featured && (
			<section class="featured" aria-labelledby="f-title">
				<div class="wide">
					<div class="f-copy">
						<span class="eyebrow">
							{CATEGORY_STYLE[catOf(featured)?.slug ?? ""]?.label ?? catOf(featured)?.label ?? "Blog"}
						</span>
						<h2 class="t-heading" id="f-title">
							<a href={blogUrl(featured.id)} style="text-decoration:none">{featured.data.title}</a>
						</h2>
						{featured.data.excerpt && <p>{featured.data.excerpt}</p>}
						<a class="link-text" href={blogUrl(featured.id)}>Devamını okuyun</a>
					</div>
					<div class="f-art">
						{fScreens[0] && (
							<figure class="screen" style="left:8%;top:0;width:290px;height:600px">
								<img src={`/assets/ekranlar/${fScreens[0]}.webp`} alt={fd.ekran_aciklama || featured.data.title} />
							</figure>
						)}
						{fScreens[1] && (
							<figure class="screen" style="left:calc(8% + 320px);top:80px;width:290px;height:600px">
								<img src={`/assets/ekranlar/${fScreens[1]}.webp`} alt="" />
							</figure>
						)}
						{fd.balon && (
							<div class="chip-card" style="left:calc(8% + 200px);top:300px;width:230px;z-index:3">
								{fd.balon_ust && <div class="k">{fd.balon_ust}</div>}
								<div class="v">{fd.balon}</div>
							</div>
						)}
					</div>
				</div>
			</section>
		)
	}

	<section class="posts">
		{
			posts.length === 0 && (
				<p class="t-intro" style="text-align:center">Henüz yayımlanmış yazı yok.</p>
			)
		}
		{
			rest.map((post, i) => (
				<PostRow
					post={post}
					category={catOf(post)}
					hidden={i >= 5}
					anchor={i === firstGuide ? "rehber" : undefined}
				/>
			))
		}
		{
			rest.length > 5 && (
				<div class="load-more">
					<button class="btn btn-outline" id="more">Daha fazla yükle</button>
				</div>
			)
		}
	</section>
	<script is:inline slot="scripts">
		(function () {
			var b = document.getElementById("more");
			var h = [].slice.call(document.querySelectorAll(".post-row.hidden"));
			if (!b) return;
			function showAll() {
				h.forEach(function (r) { r.classList.remove("hidden"); });
				b.parentElement.remove();
			}
			b.addEventListener("click", showAll);
			if (location.hash === "#rehber") showAll();
		})();
	</script>
</Base>
