---
export const prerender = false;

import { search, SearchUnavailableError, type SearchResponse } from "emdash";
import Base from "../layouts/Base.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";
let res: SearchResponse = { items: [] };
let unavailable = false;
if (query) {
	try {
		res = await search(query, { collections: ["posts", "pages"], limit: 30 });
	} catch (error) {
		if (!(error instanceof SearchUnavailableError)) throw error;
		unavailable = true;
	}
}
const rows = res.items.map((r: any) => ({
	path: r.collection === "pages" ? `/${r.slug ?? r.id}` : `/posts/${r.slug ?? r.id}`,
	title: r.title ?? "Başlıksız",
	snippet: r.snippet,
}));
---

<Base title={query ? `Arama: ${query}` : "Arama"} description="Ahırım Cebimde sitesinde arayın." robots="noindex">
	<section class="page-head">
		<h1 class="t-display">Ne arıyorsunuz?</h1>
		<form class="search-form" method="get" action="/search" role="search">
			<label for="q" class="sr-only">Sitede arayın</label>
			<input id="q" class="search-input" type="search" name="q" value={query} placeholder="Örneğin: kuruya çıkarma" autofocus={!query} />
			<button type="submit" class="btn btn-compact">Ara</button>
		</form>
	</section>
	{
		query && (
			<section class="faq">
				{unavailable ? (
					<p class="t-intro">Arama şu an kullanılamıyor. Lütfen daha sonra yeniden deneyin.</p>
				) : rows.length === 0 ? (
					<p class="t-intro">“{query}” için sonuç bulunamadı. <a class="link-text" href="/posts">Tüm yazılara</a> göz atın.</p>
				) : (
					<>
						<h2 class="t-heading-small">{rows.length} sonuç</h2>
						{rows.map((r) => (
							<div class="search-row">
								<a href={r.path}>{r.title}</a>
								{r.snippet && <p set:html={r.snippet} />}
							</div>
						))}
					</>
				)}
			</section>
		)
	}
</Base>
