---
import Base from "../layouts/Base.astro";
import html from "../fragments/iletisim.html?raw";
import { getSiteSettings } from "emdash";
import { DEFAULT_FACEBOOK, DEFAULT_INSTAGRAM } from "../lib/site";
const social = (await getSiteSettings())?.social ?? {};
const body = html
	.replaceAll(DEFAULT_FACEBOOK, social.facebook || DEFAULT_FACEBOOK)
	.replaceAll(DEFAULT_INSTAGRAM, social.instagram || DEFAULT_INSTAGRAM);
---

<Base title="İletişim" description="Ahırım Cebimde ile iletişim: e-posta, uygulama içi destek ve sosyal medya.">
	<Fragment set:html={body} />
</Base>
