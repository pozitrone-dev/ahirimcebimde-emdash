---
import { getEmDashEntry, getSeoMeta, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { SITE_NAME } from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(page, {
	siteTitle: SITE_NAME,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const meta = (page.data as any).ust_bilgi as string | undefined;
---

<Base
	title={page.data.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<div class="post-top">
		<h1 class="t-heading post-title" {...page.edit.title}>{page.data.title}</h1>
		{
			meta && (
				<p class="post-body meta" style="padding:0">
					{meta.split("\n").map((line, i) => (
						<>
							{i > 0 && <br />}
							{line}
						</>
					))}
				</p>
			)
		}
	</div>
	<article class="post-body pt" {...page.edit.content}>
		<PortableText value={page.data.content} />
	</article>
	<script is:inline slot="scripts">
		// Give each section heading a stable anchor (e.g. /pages/gizlilik#haklariniz):
		// the first word after the section number, lower-cased and ASCII-folded.
		(function () {
			var map = { ç: "c", ğ: "g", ı: "i", İ: "i", ö: "o", ş: "s", ü: "u" };
			var used = {};
			document.querySelectorAll(".post-body.pt h2").forEach(function (h) {
				if (h.id) return;
				var w = h.textContent.replace(/^\s*[\dA-Z]{1,3}\.\s*/, "").trim().split(/\s+/)[0] || "bolum";
				var id = w.toLocaleLowerCase("tr").replace(/[çğıİöşü]/g, function (c) { return map[c] || c; }).replace(/[^a-z0-9-]/g, "");
				if (used[id]) id += "-" + ++used[id]; else used[id] = 1;
				h.id = id;
			});
			if (location.hash) {
				var t = document.getElementById(location.hash.slice(1));
				if (t) t.scrollIntoView();
			}
		})();
	</script>
</Base>
