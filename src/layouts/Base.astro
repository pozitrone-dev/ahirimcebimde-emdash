---
/**
 * Ahırım Cebimde base layout.
 *
 * Header, footer and all global styles come from the Ahırım Cebimde design
 * system (public/assets/site.css + pages.css). Navigation is read from the
 * EmDash menus "primary", "footer" and "legal"; social links from site
 * settings. See src/lib/site.ts for fallbacks.
 */
import {
	getMenuWithCacheHint,
	getSiteSettingsWithCacheHint,
} from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
	DEFAULT_FACEBOOK,
	DEFAULT_INSTAGRAM,
	FALLBACK_FOOTER,
	FALLBACK_LEGAL,
	FALLBACK_PRIMARY,
	SITE_DESC,
	SITE_NAME,
	pick,
} from "../lib/site";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Load the inner-page stylesheet (blog, legal, FAQ). */
	inner?: boolean;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	inner = true,
	content,
} = Astro.props;

const [settingsResult, primaryResult, footerResult, legalResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer"),
		getMenuWithCacheHint("legal"),
	]);
if (Astro.cache?.enabled) {
	for (const r of [settingsResult, primaryResult, footerResult, legalResult])
		Astro.cache.set(r.cacheHint);
}
const settings = settingsResult.data;
const social = settings?.social ?? {};
const instagram = social.instagram || DEFAULT_INSTAGRAM;
const facebook = social.facebook || DEFAULT_FACEBOOK;

const fullTitle = title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: description ?? SITE_DESC,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: SITE_NAME,
});
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link rel="icon" href="/assets/icon.png" />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/assets/site.css" />
		{inner && <link rel="stylesheet" href="/assets/pages.css" />}
		<link rel="stylesheet" href="/assets/emdash.css" />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<SiteHeader items={pick(primaryResult.data?.items, FALLBACK_PRIMARY)} />
		<main id="main">
			<slot />
		</main>
		<SiteFooter
			columns={pick(footerResult.data?.items, FALLBACK_FOOTER)}
			legal={pick(legalResult.data?.items, FALLBACK_LEGAL)}
			instagram={instagram}
			facebook={facebook}
		/>
		<script is:inline src="/assets/site.js"></script>
		<slot name="scripts" />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
